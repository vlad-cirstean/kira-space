+
+  # The published installer on a clean macOS runner, both entry points. `--app=space` installs
+  # Kira Space. `--app=studio` is the old Kira Studio updater's path: it installs Kira Space, moves
+  # a stand-in Kira Studio.app to the Trash and leaves ~/.kira-studio alone. Runs after publish
+  # because the installer downloads the latest published release.
+  install-smoke:
+    name: install smoke (macOS)
+    needs: [tag, publish]
+    runs-on: macos-26
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          ref: ${{ needs.tag.outputs.sha }}
+      - name: Install with --app=space
+        run: |
+          set -eu
+          sh scripts/install.sh --app=space
+          test "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "/Applications/Kira Space.app/Contents/Info.plist")" = com.kirathecat.kira-space
+          codesign --verify --deep --strict "/Applications/Kira Space.app"
+          pkill -x "Kira Space" || true; sleep 3
+      - name: Install with --app=studio over a stand-in Kira Studio.app
+        run: |
+          set -eu
+          OLD="/Applications/Kira Studio.app"
+          mkdir -p "$OLD/Contents/MacOS" "$HOME/.kira-studio"
+          printf 'keep' > "$HOME/.kira-studio/marker"
+          cat > "$OLD/Contents/Info.plist" <<'EOF'
+          <?xml version="1.0" encoding="UTF-8"?>
+          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+          <plist version="1.0"><dict>
+          <key>CFBundleIdentifier</key><string>com.kirathecat.kira-studio</string>
+          <key>CFBundleName</key><string>Kira Studio</string>
+          </dict></plist>
+          EOF
+          sh scripts/install.sh --app=studio
+          test ! -e "$OLD"
+          ls "$HOME/.Trash" | grep -q '^Kira Studio'
+          test "$(cat "$HOME/.kira-studio/marker")" = keep
+          test "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "/Applications/Kira Space.app/Contents/Info.plist")" = com.kirathecat.kira-space
+          pkill -x "Kira Space" || true; sleep 3
