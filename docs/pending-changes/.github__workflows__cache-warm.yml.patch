P614: warm the per-group test-matrix image caches pr.yml restores.

diff --git a/.github/workflows/cache-warm.yml b/.github/workflows/cache-warm.yml
index 2336c4c31..aefd0342c 100644
--- a/.github/workflows/cache-warm.yml
+++ b/.github/workflows/cache-warm.yml
@@ -123,6 +123,57 @@ jobs:
           path: ~/docker-images.tar
           key: docker-${{ runner.os }}-${{ hashFiles('apps/kira-space/internal/adapters/testsupport/*.go') }}
 
+  # Mirrors pr.yml `test-matrix (Linux, <group>)`'s image cache: same groups, same key.
+  matrix-images:
+    name: warm test-matrix images (Linux, ${{ matrix.group }})
+    runs-on: ubuntu-24.04
+    timeout-minutes: 30
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - group: postgres
+            args: --only postgres
+          - group: mysqlfamily
+            args: --only mysqlfamily
+          - group: clickhouse
+            args: --only clickhouse
+          - group: rest
+            args: --except postgres,mysqlfamily,clickhouse
+    steps:
+      - uses: actions/checkout@v7
+      - uses: ./.github/actions/setup
+        with:
+          bun: "false"
+          bindings: "false"
+      - name: Resolve this group's images (same key as pr.yml)
+        id: images
+        run: |
+          set -eu
+          LIST="$(sh scripts/test-matrix.sh ${{ matrix.args }} --print-images)"
+          printf '%s\n' "$LIST"
+          echo "key=matrix-images-${{ runner.os }}-${{ matrix.group }}-$(printf '%s\n' "$LIST" | sha256sum | cut -c1-16)" >> "$GITHUB_OUTPUT"
+      - name: Look up this group's image cache
+        id: image-cache
+        uses: actions/cache/restore@v6
+        with:
+          path: ~/matrix-images.tar
+          key: ${{ steps.images.outputs.key }}
+          lookup-only: true
+      - name: Pull and pack this group's images (miss only)
+        if: steps.image-cache.outputs.cache-hit != 'true'
+        run: |
+          set -eu
+          sh scripts/test-matrix.sh ${{ matrix.args }} --mirror --pull-only
+          # shellcheck disable=SC2046
+          docker save $(sh scripts/test-matrix.sh ${{ matrix.args }} --print-images) -o ~/matrix-images.tar
+          du -h ~/matrix-images.tar
+      - if: steps.image-cache.outputs.cache-hit != 'true'
+        uses: actions/cache/save@v6
+        with:
+          path: ~/matrix-images.tar
+          key: ${{ steps.images.outputs.key }}
+
   # Mirrors the browser caches of pr.yml `ui`, `visual` (webkit) and `ui-extra` (webkit plus chromium).
   # System libraries (--with-deps) are apt packages, not in the cached path, so not installed here.
   playwright:
