{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    // graphStreamFixture.ts imports the real `@kira/git-ipc` codec rather than hand-rolling one.
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "@shared/*": ["../../packages/shared/*"],
      "@theme/*": ["../../packages/theme/src/*"],
      "@workbench/*": ["../../packages/workbench/src/*"],
      "@kira/git-ipc": ["../../packages/git-ipc/src/index.ts"],
      "@kira/git-ipc/codec": ["../../packages/git-ipc/src/codec.ts"],
      // P107 I2-27: graphStreamFixture.ts's own testing-only import of the shared packed-chunk
      // builder (this project maps every cross-package import explicitly).
      "@kira/git-core/testing/packedChunk": ["../../packages/git-core/src/testing/packedChunk.ts"]
    }
  },
  "include": [
    "../../packages/shared/**/*.ts",
    "../../packages/workbench/src/**/*.ts",
    "../../packages/workbench/env.d.ts",
    "playwright.config.ts",
    "playwright.perf.config.ts",
    "playwright.proto.config.ts",
    "tests/perf/**/*.ts",
    "tests/e2e-real/**/*.ts",
    "tests/ui/**/*.ts",
    "tests/visual/**/*.ts",
    "tests/proto/**/*.ts",
    "tests/ipc/**/*.ts",
    "tests/support/**/*.ts",
    "tests/screenshots/**/*.ts",
    "../../packages/db-fixtures/support/**/*.ts"
  ],
  // P103 Part 1: testing/unit/* imports `bun:test` (this project's own `types` is `["node"]`,
  // for tests/ui's Playwright surface, not `bun-types`) — apps/*/tests/unit/tsconfig.json is
  // its real project. P127: same reason for any *.spec.ts colocated under packages/workbench/src
  // (agentActivityReducer.spec.ts, packages/git-core/src's own precedent) — apps/*/tests/unit/
  // tsconfig.json already covers it via its own `packages/workbench/src/**/*.ts` include.
  "exclude": [
    "../../packages/workbench/src/testing/unit/**",
    "../../packages/workbench/src/**/*.spec.ts"
  ]
}
