{
  "GitHostService.Tools#azure-no-defaults": {
    "tools": [
      {
        "cli": "GitHub CLI (gh)",
        "kind": "host",
        "label": "GitHub",
        "provider": "github",
        "setup": {
          "docsUrl": "https://cli.github.com",
          "steps": [
            {
              "command": "brew install gh",
              "purpose": "install"
            },
            {
              "command": "gh auth login",
              "purpose": "login"
            },
            {
              "command": "gh auth status",
              "purpose": "check"
            }
          ]
        },
        "status": {
          "account": "octocat",
          "kind": "ok",
          "path": "<masked>",
          "probed": [],
          "reason": "",
          "site": "",
          "version": "2.42.0"
        }
      },
      {
        "cli": "Azure CLI (az)",
        "kind": "host",
        "label": "Azure Repos",
        "provider": "azure",
        "setup": {
          "docsUrl": "https://learn.microsoft.com/azure/devops/cli/",
          "steps": [
            {
              "command": "brew install azure-cli",
              "purpose": "install"
            },
            {
              "command": "az extension add --name azure-devops",
              "purpose": "extension"
            },
            {
              "command": "az login",
              "purpose": "login"
            },
            {
              "command": "az devops login --organization https://dev.azure.com/<your-org>",
              "purpose": "loginToken"
            },
            {
              "command": "az devops configure --defaults organization=https://dev.azure.com/<your-org> project=<your-project>",
              "purpose": "defaults"
            },
            {
              "command": "az devops project list --top 1",
              "purpose": "check"
            }
          ]
        },
        "status": {
          "account": "",
          "kind": "unauthenticated",
          "path": "<masked>",
          "probed": [],
          "reason": "set a default organization: `az devops configure --defaults organization=https://dev.azure.com/<org>`",
          "site": "",
          "version": ""
        }
      }
    ]
  },
