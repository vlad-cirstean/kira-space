      "headers": { "Authorization": "Bearer @GH@" }
    },
    "notes": {
      "command": "/usr/bin/notes",
      "args": ["${HOME}/notes"],
      "env": { "API_KEY": "@NOTES@" }
    },
    "old": { "type": "sse", "url": "https://example.com/sse" },
    "kira-db": { "type": "http", "url": "http://127.0.0.1:1/mcp" }
  }
}
