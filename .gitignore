# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Playwright
test-results/
test-results-perf/
test-results-studio/
test-results-proto/

# tests/e2e-real/fixtures.ts's own cross-process build lock (F10, P108 Part 6) — reclaimed
# automatically by a stale-lock check, but never repo content either way.
.e2e-real-build.lock

# macOS
.DS_Store

# Claude Code agent worktrees — isolated scratch checkouts for background
# subagents (see .claude/worktrees/*), never repo content. Project-level hook
# config (settings.json, hooks/) is repo content and stays tracked.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/*

# Design canvas — the seeded page is a 3 MB build product (it bundles the
# canvas editor). Rebuild it with docs/design/kira-design-system/build.mjs
# and the design skill's seed-canvas.mjs; the design itself lives in parts/.
docs/design/*/[a-z]*-design-system.html

# SQLite demo database — a build product of scripts/demo-dbs/sqlite/seed.ts,
# regenerated on demand (P35 D36); the other seven engines' demo data lives
# in containers instead, so this is the one on-disk artifact of the set.
scripts/demo-dbs/sqlite/*.sqlite

# flatc compiler, fetched on demand by scripts/generate-wire.sh (P11 D12) — the code it
# generates is committed, the compiler itself is not.
.tools/

# kira-repo-map headless dev binary — built on demand by scripts/mcp-repo-map.ts (C3 §3.1),
# never packaged (the embedded instance is the app's own executable, C3 §3.2).
apps/kira-space/bin/

# CodeGraph local index (machine-local, rebuilt by scripts/codegraph-setup.sh)
.codegraph/

# P163 prototype build (apps/kira-space/frontend/vite.proto.config.ts), never shipped.
dist-proto/
dist-proto-hooks/

# Root-level go build output (go build ./apps/...), never repo content.
/kira-space
/kira-studio
apps/kira-space/bin/

# flow coverage gate (the "coverage" rule above would hide it)
!apps/*/internal/flows/coverage/

# Astro generated types (site/)
site/.astro/

# commentsweep work dir (P320)
.commentsweep/

# Product screenshots are WebP only (N15)
screenshots/**/*.png
