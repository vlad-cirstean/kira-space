---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import ShotGallery from '../components/ShotGallery.astro';
import { BUILD } from '../data/build';
import { href } from '../data/nav';
import Base from '../layouts/Base.astro';
import { resolveBuild } from '../lib/build';

const sections = await resolveBuild();
const first = sections[0];
---

<Base title={BUILD.title} description={BUILD.description} image={first?.lead.social}>
  <Header />
  <main data-app="space" class="relative isolate overflow-x-clip pb-20">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[30rem]">
      <div
        class="absolute -top-32 left-[10%] size-[28rem] rounded-full bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--tint)_28%,transparent),transparent)] motion-safe:animate-drift-a"
      > </div>
      <div
        class="absolute -top-20 right-[8%] size-[24rem] rounded-full bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--kira-accent)_24%,transparent),transparent)] motion-safe:animate-drift-b"
      > </div>
    </div>
    <div class="mx-auto max-w-5xl px-4 pt-10 pb-8">
      <h1
        class="hero-in bg-linear-to-b from-fg from-40% to-tint bg-clip-text pb-1 text-5xl font-semibold tracking-tight text-transparent sm:text-7xl"
      >
        {BUILD.heading}
      </h1>
      <p style="--d:120ms" class="hero-in mt-4 max-w-3xl text-lg text-muted">{BUILD.intro}</p>
    </div>
    <nav
      aria-label="Steps"
      class="z-[5] border-y border-border bg-chrome/95 backdrop-blur md:sticky md:top-[3.75rem]"
    >
      <ol class="mx-auto flex max-w-5xl flex-col px-4 md:flex-row md:flex-wrap md:gap-x-2">
        {sections.map((s) => (
          <li>
            <a
              href={`#${s.anchor}`}
              class="flex min-h-11 items-center gap-2 text-base text-muted hover:text-fg md:px-2"
            >
              <span class="font-medium text-fg">{s.step}.</span>
              {s.name}
            </a>
          </li>
        ))}
      </ol>
    </nav>
    {sections.map((s) => (
      <section id={s.anchor} class="mx-auto max-w-5xl scroll-mt-20 px-4 pt-16 md:scroll-mt-32">
        <div class="reveal">
          <p class="w-fit rounded-full bg-tint/10 px-3 py-0.5 text-base font-medium text-tint ring-1 ring-tint/25">
            Step {s.step}
          </p>
          <h2 class="mt-1 text-2xl font-semibold tracking-tight sm:text-4xl">{s.name}</h2>
          <p class="mt-4 max-w-3xl text-lg text-fg">{s.pitch}</p>
          <p class="mt-3 max-w-3xl text-base text-muted">{s.body}</p>
        </div>
        <ShotGallery shots={s.resolved} />
      </section>
    ))}
    <div class="mx-auto max-w-5xl px-4 pt-16">
      <a
        href={`${href()}#install`}
        class="reveal flex min-h-11 w-fit items-center gap-2 rounded-lg bg-accent px-5 font-medium text-accent-fg shadow-[0_8px_28px_-8px_color-mix(in_srgb,var(--kira-accent)_70%,transparent)] hover:opacity-90 motion-safe:transition-transform motion-safe:hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        <Icon name="arrow-right" class="size-4" />
        Install Kira Space
      </a>
    </div>
  </main>
  <Footer />
</Base>
