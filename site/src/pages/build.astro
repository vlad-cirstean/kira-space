---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import ShotGallery from '../components/ShotGallery.astro';
import { BUILD } from '../data/build';
import { href } from '../data/nav';
import Base from '../layouts/Base.astro';
import { resolveBuild } from '../lib/build';

const sections = await resolveBuild();
const first = sections[0];
---

<Base title={BUILD.title} description={BUILD.description} image={first?.lead.social}>
  <Header />
  <main data-app="space" class="pb-20">
    <div class="mx-auto max-w-5xl px-4 pt-10 pb-8">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-6xl">{BUILD.heading}</h1>
      <p class="mt-4 max-w-3xl text-lg text-muted">{BUILD.intro}</p>
    </div>
    <nav
      aria-label="Steps"
      class="z-[5] border-y border-border bg-chrome/95 backdrop-blur md:sticky md:top-[3.75rem]"
    >
      <ol class="mx-auto flex max-w-5xl flex-col px-4 md:flex-row md:flex-wrap md:gap-x-2">
        {sections.map((s) => (
          <li>
            <a
              href={`#${s.anchor}`}
              class="flex min-h-11 items-center gap-2 text-base text-muted hover:text-fg md:px-2"
            >
              <span class="font-medium text-fg">{s.step}.</span>
              {s.name}
            </a>
          </li>
        ))}
      </ol>
    </nav>
    {sections.map((s) => (
      <section id={s.anchor} class="mx-auto max-w-5xl scroll-mt-20 px-4 pt-16 md:scroll-mt-32">
        <p class="text-base font-medium text-tint">Step {s.step}</p>
        <h2 class="mt-1 text-2xl font-semibold tracking-tight sm:text-4xl">{s.name}</h2>
        <p class="mt-4 max-w-3xl text-lg text-fg">{s.pitch}</p>
        <p class="mt-3 max-w-3xl text-base text-muted">{s.body}</p>
        <ShotGallery shots={s.resolved} />
      </section>
    ))}
    <div class="mx-auto max-w-5xl px-4 pt-16">
      <a
        href={`${href()}#install`}
        class="flex min-h-11 w-fit items-center gap-2 rounded-lg bg-accent px-5 font-medium text-accent-fg hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        <Icon name="arrow-right" class="size-4" />
        Install Kira Space
      </a>
    </div>
  </main>
  <Footer />
</Base>
