---
import Icon from '../components/Icon.astro';
import { href } from '../data/nav';
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="Page not found.">
  <main class="mx-auto max-w-5xl px-4 py-20">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-6xl">Page not found.</h1>
    <a
      href={href()}
      class="mt-8 flex min-h-11 w-fit items-center gap-2 rounded-lg bg-accent px-5 font-medium text-accent-fg hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      <Icon name="arrow-right" class="size-4" />
      Back to Kira Space
    </a>
    <p class="mt-6 text-base text-muted">
      Looking for something?
      <a href={href('docs/')} class="text-accent underline underline-offset-4">Search the docs</a>
      with the search box in the header.
    </p>
  </main>
</Base>
