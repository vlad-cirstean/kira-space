---
import { APP } from '../data/content';
import { href } from '../data/nav';
import type { ResolvedWindowShot } from '../lib/shots';
import Icon from './Icon.astro';
import ShotPicture from './ShotPicture.astro';
import Sparkle from './Sparkle.astro';

interface Props {
  shots: readonly ResolvedWindowShot[];
}

const { shots } = Astro.props;
const shotTiles = APP.features.flatMap((f) => {
  const shot = shots.find((s) => s.id === f.shot);
  return f.shot && shot ? [{ ...f, resolved: shot }] : [];
});
const textTiles = APP.features.filter((f) => !f.shot);
const link =
  "relative inline-flex min-h-11 items-center text-xl font-semibold tracking-tight text-fg after:absolute after:-inset-5 after:content-[''] focus-visible:outline-none";
const tile =
  'glass group relative isolate flex flex-col overflow-hidden rounded-3xl focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-accent motion-safe:transition-[transform,box-shadow] motion-safe:duration-300 motion-safe:hover:-translate-y-1 hover:shadow-[0_12px_30px_-18px_var(--tile)]';
---

<section class="relative isolate mx-auto max-w-6xl px-4 py-24 lg:py-32">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[60rem] w-screen -translate-x-1/2 bg-[radial-gradient(ellipse_50%_30%_at_20%_40%,color-mix(in_srgb,var(--brand-sky)_16%,transparent),transparent),radial-gradient(ellipse_45%_30%_at_85%_60%,color-mix(in_srgb,var(--kira-status-pink)_12%,transparent),transparent)]"
  ></div>
  <div class="mx-auto max-w-3xl text-center">
    <span
      class="inline-flex items-center gap-2 rounded-full bg-brand-sky/10 px-3 py-1 text-sm font-semibold uppercase tracking-[0.14em] text-brand-glow border border-brand-sky/30"
    >
      <Sparkle class="size-3" />
      Everything in one window
    </span>
    <h2 class="mt-5 text-4xl leading-[1.05] font-bold tracking-[-0.03em] sm:text-5xl lg:text-6xl">
      Less tab juggling.
      <span class="gradient-text block pb-1">More shipping.</span>
    </h2>
  </div>
  <ul class="mt-14 grid gap-5 md:grid-cols-2">
    {shotTiles.map((f) => (
      <li
        style={`--tile:var(--kira-status-${f.color});--glass:var(--kira-status-${f.color})`}
        class={`${tile} p-4 sm:p-5`}
      >
        <ShotPicture
          shot={f.resolved}
          sizes="(min-width: 1152px) 560px, (min-width: 768px) 50vw, 100vw"
        />
        <h3 class="mt-3">
          <a href={href(f.href)} class={link}>
            {f.title}
          </a>
        </h3>
        <p class="mt-1 text-base text-muted">{f.line}</p>
      </li>
    ))}
  </ul>
  <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
    {textTiles.map((f) => (
      <li
        style={`--tile:var(--kira-status-${f.color});--glass:var(--kira-status-${f.color})`}
        class={`${tile} p-5`}
      >
        {f.icon && (
          <span
            aria-hidden="true"
            class="flex size-11 items-center justify-center rounded-full bg-(--tile)/15 text-(--tile) border border-(--tile)/30"
          >
            <Icon name={f.icon} class="size-6" />
          </span>
        )}
        <h3 class="mt-3">
          <a href={href(f.href)} class={link}>
            {f.title}
          </a>
        </h3>
        <p class="mt-1 text-base text-muted">{f.line}</p>
      </li>
    ))}
  </ul>
</section>
