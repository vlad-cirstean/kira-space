---
import type { ResolvedWindowShot } from '../lib/shots';

interface Props {
  shot: ResolvedWindowShot;
  eager?: boolean;
  class?: string;
}

const { shot, eager = false, class: className } = Astro.props;
---

<img
  src={shot.framed}
  srcset={`${shot.framedSmall} 1136w, ${shot.framed} ${shot.framedWidth}w`}
  sizes="(min-width: 1024px) 1024px, 100vw"
  alt={shot.alt}
  data-shot={shot.id}
  width={shot.framedWidth}
  height={shot.framedHeight}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  class:list={['h-auto w-full', className]}
>
