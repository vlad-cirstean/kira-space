---
import type { ResolvedWindowShot } from '../lib/shots';

interface Props {
  shot: ResolvedWindowShot;
  eager?: boolean;
  class?: string;
  sizes?: string;
  priority?: boolean;
}

const {
  shot,
  eager = false,
  class: className,
  sizes = '(min-width: 1024px) 1024px, 100vw',
  priority = false,
} = Astro.props;
---

<img
  src={shot.framed}
  srcset={`${shot.framedThumb} 800w, ${shot.framedSmall} 1136w, ${shot.framed} ${shot.framedWidth}w`}
  sizes={sizes}
  alt={shot.alt}
  data-shot={shot.id}
  width={shot.framedWidth}
  height={shot.framedHeight}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : undefined}
  decoding="async"
  class:list={['h-auto w-full', className]}
>
