---
import { BUILD } from '../data/build';
import type { ResolvedBuildSection } from '../lib/build';
import Icon from './Icon.astro';
import ShotPicture from './ShotPicture.astro';

interface Props {
  sections: readonly ResolvedBuildSection[];
}

const { sections } = Astro.props;
const count = sections.length;
const btn =
  'flex size-11 items-center justify-center rounded-full bg-chrome/90 text-fg ring-1 ring-border-strong hover:bg-elevated focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
---

<!-- biome-ignore lint/a11y/useSemanticElements: APG carousel pattern needs roledescription on a region div -->
<div
  data-carousel
  role="region"
  aria-roledescription="carousel"
  aria-label={BUILD.carouselLabel}
  class="relative mx-auto max-w-5xl px-4"
>
  <div
    data-track
    aria-live="off"
    tabindex="-1"
    class="flex snap-x snap-mandatory overflow-x-auto rounded-xl [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
  >
    {sections.map((s) => (
      <section
        aria-roledescription="slide"
        aria-label={`${s.step} of ${count}: ${s.name}`}
        data-slide
        class="w-full shrink-0 snap-center"
      >
        <a
          href={`#${s.anchor}`}
          class="block focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <div class="overflow-hidden rounded-xl bg-chrome ring-1 ring-border-strong md:overflow-visible md:bg-transparent md:ring-0">
            <ShotPicture shot={s.lead} eager={s.step === 1} />
          </div>
          <p class="mt-3 text-base text-fg">
            <span class="font-medium">Step {s.step}.</span> {s.name}
          </p>
        </a>
      </section>
    ))}
  </div>
  <div class="mt-4 flex items-center justify-between gap-4">
    <button type="button" data-prev aria-label="Previous step" class={btn}>
      <Icon name="arrow-right" class="size-4 rotate-180" />
    </button>
    <ol class="flex items-center">
      {sections.map((s) => (
        <li>
          <button
            type="button"
            data-dot
            aria-label={`Go to step ${s.step}: ${s.name}`}
            class="group flex size-11 items-center justify-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            <span class="size-3 rounded-full bg-border-strong group-aria-[current=true]:bg-accent"></span>
          </button>
        </li>
      ))}
    </ol>
    <button type="button" data-next aria-label="Next step" class={btn}>
      <Icon name="arrow-right" class="size-4" />
    </button>
  </div>
</div>

<script>
const INTERVAL_MS = 6000;

function setup(root: HTMLElement): void {
  const track = root.querySelector<HTMLElement>('[data-track]');
  const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
  const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
  if (!track || slides.length === 0) return;
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  const pauses = new Set<string>();
  let active = 0;
  let timer: number | undefined;

  const reduced = () => motion.matches;
  const mark = (i: number) => {
    active = i;
    dots.forEach((d, n) => {
      if (n === i) d.setAttribute('aria-current', 'true');
      else d.removeAttribute('aria-current');
    });
  };
  const stop = () => {
    window.clearTimeout(timer);
    timer = undefined;
  };
  const live = () => {
    root.dataset.paused = [...pauses].join(' ');
    track.setAttribute('aria-live', timer === undefined ? 'polite' : 'off');
  };
  const arm = () => {
    stop();
    if (!reduced() && pauses.size === 0)
      timer = window.setTimeout(() => go(active + 1), INTERVAL_MS);
    live();
  };
  const go = (to: number) => {
    const i = (to + slides.length) % slides.length;
    const slide = slides[i];
    if (!slide) return;
    mark(i);
    track.scrollTo({
      left: slide.offsetLeft - track.offsetLeft,
      behavior: reduced() ? 'auto' : 'smooth',
    });
    arm();
  };
  const pause = (reason: string, on: boolean) => {
    if (on) pauses.add(reason);
    else pauses.delete(reason);
    arm();
  };

  root.querySelector('[data-prev]')?.addEventListener('click', () => go(active - 1));
  root.querySelector('[data-next]')?.addEventListener('click', () => go(active + 1));
  for (const [n, d] of dots.entries()) d.addEventListener('click', () => go(n));
  root.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') go(active + 1);
    else if (e.key === 'ArrowLeft') go(active - 1);
  });
  root.addEventListener('pointerenter', () => pause('hover', true));
  root.addEventListener('pointerleave', () => pause('hover', false));
  root.addEventListener('focusin', () => pause('focus', true));
  root.addEventListener('focusout', (e) => {
    if (!root.contains(e.relatedTarget as Node | null)) pause('focus', false);
  });
  root.addEventListener('touchstart', () => pause('touch', true), { passive: true });
  for (const end of ['touchend', 'touchcancel'])
    root.addEventListener(end, () => pause('touch', false), { passive: true });
  new IntersectionObserver(
    (entries) => pause('offscreen', (entries[0]?.intersectionRatio ?? 0) < 0.5),
    {
      threshold: [0, 0.5, 1],
    },
  ).observe(root);
  document.addEventListener('visibilitychange', () =>
    pause('hidden', document.visibilityState !== 'visible'),
  );
  const slideObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const i = slides.indexOf(entry.target as HTMLElement);
        if (entry.isIntersecting && i !== -1 && i !== active) {
          mark(i);
          arm();
        }
      }
    },
    { root: track, threshold: 0.6 },
  );
  for (const slide of slides) slideObserver.observe(slide);
  motion.addEventListener('change', arm);
  mark(0);
  pause('hidden', document.visibilityState !== 'visible');
}

for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) setup(root);
</script>
