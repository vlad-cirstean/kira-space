---
import type { ResolvedShot } from '../lib/shots';
import ShotPicture from './ShotPicture.astro';

interface Props {
  shot: ResolvedShot;
  eager?: boolean;
  tile?: boolean;
  sizes?: string;
}

const { shot, eager = false, tile = false, sizes } = Astro.props;
---

<figure class="relative m-0">
  {shot.kind === 'window' ? (
    <a
      href={shot.framed}
      class="block focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      aria-label={`Open full size: ${shot.title}`}
    >
      <ShotPicture shot={shot} eager={eager} sizes={sizes} />
    </a>
  ) : (
    <a
      href={shot.crop}
      class:list={[
        'block focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
        tile &&
          'flex aspect-[4/3] items-center justify-center rounded-xl bg-elevated p-3 border border-border-strong',
      ]}
      aria-label={`Open full size: ${shot.title}`}
    >
      <img
        src={shot.crop}
        alt={shot.alt}
        data-shot={shot.id}
        width={shot.cropWidth / 2}
        height={shot.cropHeight / 2}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class:list={[
          'mx-auto block h-auto max-w-full',
          tile && 'max-h-full object-contain',
          shot.kind === 'region' && 'overflow-hidden rounded-xl border border-border-strong',
        ]}
      >
    </a>
  )}
  <figcaption class="mt-3 text-base text-muted">
    <span class="font-medium text-fg">{shot.title}.</span>{' '}
    {shot.caption.replace(/^[^.]*\.\s*/, '')}
  </figcaption>
</figure>
