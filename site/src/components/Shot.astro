---
import type { ResolvedShot } from '../lib/shots';

interface Props {
  shot: ResolvedShot;
  eager?: boolean;
  glow?: boolean;
}

const { shot, eager = false, glow = false } = Astro.props;
---

<figure class="relative m-0">
  {glow && (
    <div aria-hidden="true" class="absolute -inset-4 -z-10 rounded-3xl bg-tint/10 blur-3xl"></div>
  )}
  {shot.kind === 'window' ? (
    <a
      href={shot.framed}
      class="block overflow-hidden rounded-xl bg-chrome shadow-shot ring-1 ring-border-strong md:overflow-visible md:rounded-none md:bg-transparent md:shadow-none md:ring-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      aria-label={`Open full size: ${shot.title}`}
    >
      <picture>
        <source media="(min-width: 768px)" srcset={shot.framed} type="image/webp">
        <img
          src={shot.detail}
          alt={shot.alt}
          data-shot={shot.id}
          width={shot.detailWidth}
          height={shot.detailHeight}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          style={`--shot-ar:${shot.framedWidth}/${shot.framedHeight}`}
          class="aspect-[4/3] h-auto w-full md:aspect-(--shot-ar)"
        >
      </picture>
    </a>
  ) : (
    <a
      href={shot.crop}
      class="block focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      aria-label={`Open full size: ${shot.title}`}
    >
      <img
        src={shot.crop}
        alt={shot.alt}
        data-shot={shot.id}
        width={shot.cropWidth / 2}
        height={shot.cropHeight / 2}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class:list={[
          'mx-auto block h-auto max-w-full',
          shot.kind === 'region' && 'overflow-hidden rounded-xl ring-1 ring-border-strong',
        ]}
      >
    </a>
  )}
  <figcaption class="mt-3 text-base text-muted">
    <span class="font-medium text-fg">{shot.title}.</span>{' '}
    {shot.caption.replace(/^[^.]*\.\s*/, '')}
  </figcaption>
</figure>
