---
import type { ResolvedWindowShot } from '../lib/shots';
import Icon from './Icon.astro';
import ShotPicture from './ShotPicture.astro';

interface Props {
  front: ResolvedWindowShot;
  left: ResolvedWindowShot;
  right: ResolvedWindowShot;
}

const { front, left, right } = Astro.props;
const chip =
  'glass absolute z-20 flex items-center gap-2 rounded-2xl px-3 py-2 text-xs font-medium text-fg sm:gap-2.5 sm:px-4 sm:py-3 sm:text-sm motion-safe:animate-float';
---

<div class="stage-tilt relative mx-auto mt-14 max-w-6xl px-4 pb-14 sm:mt-20 sm:pb-20">
  <div class="relative">
    <div
      aria-hidden="true"
      class="absolute inset-x-[6%] -inset-y-[8%] -z-10 rounded-full bg-[conic-gradient(from_200deg,var(--brand-sky),var(--kira-status-pink),var(--kira-status-lime),var(--brand-sky))] opacity-60 [mask-image:radial-gradient(closest-side,#000_35%,transparent)] motion-safe:animate-breathe"
    > </div>
    <div aria-hidden="true">
      <div class="absolute left-0 top-0 w-[58%] opacity-70 saturate-75">
        <ShotPicture
          shot={left}
          eager
          decorative
          lowPriority
          sizes="(min-width: 1152px) 640px, 56vw"
        />
      </div>
      <div class="absolute right-0 top-[6%] w-[58%] opacity-70 saturate-75">
        <ShotPicture
          shot={right}
          eager
          decorative
          lowPriority
          sizes="(min-width: 1152px) 640px, 56vw"
        />
      </div>
    </div>
    <div class="relative mx-auto mt-[14%] w-[92%] sm:mt-[12%] sm:w-[86%]">
      <a
        href={front.framed}
        aria-label={`Open full size: ${front.title}`}
        class="block drop-shadow-[0_40px_60px_color-mix(in_srgb,var(--brand-deep)_55%,transparent)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        <ShotPicture shot={front} eager sizes="(min-width: 1152px) 990px, 100vw" />
      </a>
    </div>
    <div aria-hidden="true">
      <div class={`${chip} left-3 -top-5 [--glass:var(--kira-status-lime)] sm:-left-2 sm:top-[2%]`}>
        <span class="size-2.5 rounded-full bg-lime text-lime motion-safe:animate-pulse-dot"></span>
        <span>13 agents, 2 need input</span>
      </div>
      <div
        class={`${chip} max-sm:hidden right-3 top-[26%] [--glass:var(--brand-sky)] sm:-right-2 sm:top-[22%] motion-safe:[animation-delay:-2s]`}
      >
        <Icon name="git-branch" class="size-4 text-brand-glow" />
        <span class="font-mono">feat/search</span>
        <span class="rounded-full bg-lime/15 px-1.5 text-lime">+4</span>
      </div>
      <div
        class={`${chip} -bottom-5 right-3 [--glass:var(--kira-status-pink)] sm:-right-4 sm:bottom-[6%] motion-safe:[animation-delay:-4s]`}
      >
        <Icon name="check" class="size-4 text-teal" />
        <span>Review passed</span>
        <span class="font-mono text-muted">12 ms</span>
      </div>
    </div>
  </div>
</div>
