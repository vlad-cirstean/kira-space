---
import { CONTAINERS } from '../../data/visuals';
---

<div class="flex h-full flex-col justify-center gap-2 font-mono text-xs sm:text-sm">
  {CONTAINERS.map((c) => (
    <div class="flex items-center gap-2.5 rounded-lg bg-white/[0.06] px-3 py-2 ring-1 ring-white/10">
      <span
        class:list={[
          'size-2.5 rounded-full',
          c.up ? 'bg-lime text-lime motion-safe:animate-pulse-dot' : 'bg-white/25',
        ]}
      ></span>
      <span class="flex-1 text-fg">{c.name}</span>
      <span class="text-subtle">{c.tag}</span>
    </div>
  ))}
  <div class="truncate rounded-lg bg-black/50 px-3 py-2 text-sky"
    ><span class="text-lime">$</span>{' '}
    ready to accept connections</div
  >
</div>
