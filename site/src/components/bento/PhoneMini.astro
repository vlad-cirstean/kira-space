---
const bars = ['sky', 'lime', 'amber'] as const;
---

<div class="flex h-full items-center justify-center">
  <div
    class="w-32 rounded-[1.8rem] bg-black/50 p-2 ring-2 ring-white/20 shadow-[0_0_40px_-8px_var(--kira-status-teal)]"
  >
    <div class="mx-auto mb-2 h-1.5 w-10 rounded-full bg-white/20"></div>
    <div class="flex flex-col gap-2 pb-2">
      {bars.map((c) => (
        <div
          class="relative h-9 overflow-hidden rounded-xl bg-white/[0.07] pl-4 pr-2"
          style={`--c:var(--kira-status-${c})`}
        >
          <span class="absolute inset-y-0 left-0 w-1.5 bg-(--c)"></span>
          <span class="mt-2.5 block h-1.5 w-3/4 rounded-full bg-white/25"></span>
          <span class="mt-1 block h-1 w-1/2 rounded-full bg-white/10"></span>
        </div>
      ))}
    </div>
  </div>
</div>
