---
import { AGENT_ROWS } from '../../data/visuals';
---

<div class="flex h-full flex-col justify-between gap-3 font-mono text-xs sm:text-sm">
  <div class="flex items-center gap-2 text-subtle">
    {['Plan', 'Implement', 'Review', 'Release'].map((s) => (
      <span class="flex-1 rounded-md bg-white/5 px-2 py-1 text-center">{s}</span>
    ))}
  </div>
  {AGENT_ROWS.map((r, i) => (
    <div
      style={`--c:var(--kira-status-${r.color})`}
      class={`relative flex items-center gap-3 overflow-hidden rounded-xl bg-white/[0.05] py-4 pl-5 pr-3 ring-1 ring-white/10 ${i >= 4 ? 'max-sm:hidden' : ''}`}
    >
      <span class="absolute inset-y-0 left-0 w-1.5 bg-(--c) shadow-[0_0_16px_var(--c)]"></span>
      <span class="min-w-0 flex-1">
        <span class="block truncate font-sans text-sm font-semibold text-fg sm:text-base">
          {r.name}
        </span>
        <span class="mt-2 block h-1.5 overflow-hidden rounded-full bg-white/10">
          <span
            style={`width:${r.pct}%`}
            class="fill-x block h-full rounded-full bg-linear-to-r from-(--c) to-white/80"
          ></span>
        </span>
      </span>
      <span class="hidden rounded-full px-2 py-0.5 text-xs text-(--c) ring-1 ring-(--c)/40 min-[420px]:block">
        {r.stage}
      </span>
      <span
        class:list={[
          'size-2.5 shrink-0 rounded-full bg-(--c) text-(--c)',
          r.live && 'motion-safe:animate-pulse-dot',
        ]}
        style={`animation-delay:${i * 0.5}s`}
      ></span>
    </div>
  ))}
  <div class="flex items-center gap-2 pt-1 text-muted">
    <span class="size-2.5 rounded-full bg-lime text-lime motion-safe:animate-pulse-dot"></span>
    13 agents, 2 need input
  </div>
</div>
