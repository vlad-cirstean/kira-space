---
const dots = [
  [40, 20, 'main'],
  [40, 60, 'main'],
  [40, 100, 'main'],
  [40, 150, 'main'],
  [110, 40, 'feat'],
  [110, 80, 'feat'],
  [110, 120, 'feat'],
  [180, 70, 'fix'],
  [180, 110, 'fix'],
] as const;
const col = {
  main: 'var(--brand-sky)',
  feat: 'var(--kira-status-pink)',
  fix: 'var(--kira-status-lime)',
};
---

<svg viewBox="0 0 360 175" class="h-full max-h-56 w-full" role="presentation">
  <g fill="none" stroke-width="2.5" stroke-linecap="round">
    <path pathLength="1" class="draw" stroke={col.main} d="M40 8V170" />
    <path
      pathLength="1"
      class="draw"
      stroke={col.feat}
      d="M40 30C40 40 110 24 110 40V130C110 142 40 130 40 140"
    />
    <path
      pathLength="1"
      class="draw"
      stroke={col.fix}
      d="M110 58C110 68 180 54 180 70V118C180 132 110 112 110 124"
    />
  </g>
  {dots.map(([x, y, k]) => (
    <circle
      cx={x}
      cy={y}
      r="6"
      fill="var(--kira-bg)"
      stroke={col[k]}
      stroke-width="3"
      style={`filter:drop-shadow(0 0 5px ${col[k]})`}
    />
  ))}
  <g font-family="JetBrains Mono, monospace" font-size="10.5" fill="var(--kira-fg)">
    <text x="205" y="30">a91c3e2 Add search</text>
    <text x="205" y="62" fill="var(--kira-fg-muted)">7be04d1 Index titles</text>
    <text x="205" y="94" fill="var(--kira-fg-muted)">c3f81a0 Merge search</text>
    <text x="205" y="126" fill="var(--kira-fg-muted)">2d5e9b7 Fix paging</text>
    <text x="205" y="158" fill="var(--kira-fg-subtle)">e08a7c4 Initial</text>
  </g>
  <g font-family="JetBrains Mono, monospace" font-size="10" font-weight="600">
    <rect
      x="52"
      y="2"
      width="38"
      height="16"
      rx="8"
      fill="color-mix(in srgb, var(--brand-sky) 25%, transparent)"
    />
    <text x="59" y="14" fill="var(--brand-glow)">main</text>
    <rect
      x="122"
      y="22"
      width="76"
      height="16"
      rx="8"
      fill="color-mix(in srgb, var(--kira-status-pink) 22%, transparent)"
    />
    <text x="129" y="34" fill="var(--kira-status-pink)">feat/search</text>
  </g>
</svg>
