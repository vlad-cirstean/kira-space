---
import { MCP_SWITCHES } from '../../data/visuals';
---

<div class="flex h-full flex-col justify-center gap-2.5 font-mono text-xs sm:text-sm">
  {MCP_SWITCHES.map((s) => (
    <div class="flex items-center gap-3 rounded-lg bg-white/[0.06] px-3 py-2 ring-1 ring-white/10">
      <span class="min-w-0 flex-1 truncate">{s.name}</span>
      <span
        class:list={[
          'flex h-5 w-9 items-center rounded-full p-0.5',
          s.on
            ? 'justify-end bg-violet shadow-[0_0_14px_var(--kira-status-violet)]'
            : 'bg-white/15',
        ]}
      >
        <span class="size-4 rounded-full bg-white"></span>
      </span>
    </div>
  ))}
</div>
