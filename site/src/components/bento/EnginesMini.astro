---
import { ENGINES } from '../../data/content';

const palette = [
  'blue',
  'cyan',
  'orange',
  'teal',
  'amber',
  'green',
  'red',
  'violet',
  'magenta',
  'indigo',
];
---

<div class="grid h-full grid-cols-2 content-center gap-2 font-mono text-xs sm:text-sm">
  {ENGINES.map((n, i) => (
    <span class="flex items-center gap-2 rounded-lg bg-white/[0.06] px-2.5 py-2 ring-1 ring-white/10">
      <span
        class="size-2.5 shrink-0 rounded-full"
        style={`background:var(--kira-conn-${palette[i]});box-shadow:0 0 10px var(--kira-conn-${palette[i]})`}
      ></span>
      <span class="truncate">{n}</span>
    </span>
  ))}
</div>
