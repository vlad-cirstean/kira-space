---
import type { Feature } from '../data/content';
import { href } from '../data/nav';
import Icon from './Icon.astro';

interface Props {
  features: readonly Feature[];
}

const { features } = Astro.props;
---

<section class="mx-auto max-w-5xl px-4 pb-16">
  <h2 class="reveal text-2xl font-semibold tracking-tight sm:text-4xl">What you get</h2>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {features.map((f, i) => (
      <li
        style={`--i:${i % 3}`}
        class="reveal group relative overflow-hidden rounded-xl border border-border bg-elevated p-5 shadow-card hover:border-tint/50 motion-safe:transition-[transform,border-color] motion-safe:hover:-translate-y-1"
      >
        <span
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_0%,color-mix(in_srgb,var(--tint)_14%,transparent),transparent)] opacity-0 group-hover:opacity-100 motion-safe:transition-opacity motion-safe:duration-300"
        ></span>
        <span class="relative flex size-10 items-center justify-center rounded-lg bg-tint/10 text-tint ring-1 ring-tint/20 motion-safe:transition-transform motion-safe:group-hover:scale-110">
          <Icon name={f.icon} class="size-5" />
        </span>
        <h3 class="relative mt-4 font-medium text-fg">
          {f.href ? (
            <a
              href={href(f.href)}
              class="inline-flex min-h-11 items-center underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              {f.title}
            </a>
          ) : (
            f.title
          )}
        </h3>
        <p class="relative mt-1 text-base text-muted">{f.body}</p>
      </li>
    ))}
  </ul>
</section>
