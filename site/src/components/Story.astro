---
import { STORY } from '../data/content';
import type { ResolvedWindowShot } from '../lib/shots';
import Shot from './Shot.astro';
import Sparkle from './Sparkle.astro';

interface Props {
  shots: readonly ResolvedWindowShot[];
}

const { shots } = Astro.props;
const colors = ['sky', 'teal', 'amber', 'pink'] as const;
---

<section
  class="relative isolate mx-auto max-w-6xl px-4 pb-8 pt-8 lg:pb-8"
  aria-labelledby="story-title"
>
  <div class="mx-auto max-w-3xl text-center">
    <span
      class="inline-flex items-center gap-2 rounded-full bg-pink/10 px-3 py-1 text-sm font-semibold uppercase tracking-[0.14em] text-pink border border-pink/30"
    >
      <Sparkle class="size-3" />
      How it feels
    </span>
    <h2
      id="story-title"
      class="mt-5 text-4xl leading-[1.05] font-bold tracking-[-0.03em] sm:text-5xl lg:text-6xl"
    >
      From idea to <span class="gradient-text">merged.</span>
    </h2>
  </div>
  <div class="mt-16 flex flex-col gap-20 lg:mt-24 lg:gap-28">
    {STORY.map((c, i) => (
      <article class="grid items-center gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
        <div class="relative pl-8" style={`--glass:var(--kira-status-${colors[i]})`}>
          <span
            aria-hidden="true"
            class="absolute bottom-0 left-[7px] top-0 w-0.5 rounded-full bg-white/15"
          ></span>
          <span
            aria-hidden="true"
            class="absolute bottom-0 left-[7px] top-0 w-0.5 rounded-full bg-linear-to-b from-brand-sky via-pink to-lime"
          ></span>
          <Sparkle class="absolute left-0 top-1.5 size-4 text-brand-glow" />
          <span class="gradient-text block text-7xl leading-none font-extrabold tracking-[-0.05em] lg:text-9xl">
            0{i + 1}
          </span>
          <h3 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{c.title}</h3>
          <ul class="mt-5 flex flex-col gap-3">
            {c.points.map((pt) => (
              <li class="flex gap-3 text-base text-muted sm:text-lg">
                <span class="mt-1.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-lime/15 text-lime">
                  <svg viewBox="0 0 16 16" aria-hidden="true" class="size-3" fill="currentColor">
                    <path d="M13.7 4.3 6.5 11.5 2.3 7.3l1-1 3.2 3.2 6.2-6.2z" />
                  </svg>
                </span>
                {pt}
              </li>
            ))}
          </ul>
        </div>
        <div class="relative">
          <div
            aria-hidden="true"
            class="absolute inset-[8%] -z-10 rounded-full bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--brand-sky)_30%,transparent),color-mix(in_srgb,var(--kira-status-pink)_14%,transparent)_65%,transparent)]"
          ></div>
          <Shot shot={shots[i] as ResolvedWindowShot} sizes="(min-width: 1152px) 660px, 100vw" />
        </div>
      </article>
    ))}
  </div>
</section>
