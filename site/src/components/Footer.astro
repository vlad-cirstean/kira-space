---
import { Image } from 'astro:assets';
import appIcon from '../../../apps/kira-space/build/appicon.png';
import { REPO_URL } from '../data/nav';
---

<footer class="relative bg-chrome">
  <div
    aria-hidden="true"
    class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-brand-sky via-pink to-lime"
  ></div>
  <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 px-4 py-6 text-base text-muted">
    <span class="flex items-center gap-2 font-semibold text-fg">
      <Image
        src={appIcon}
        alt=""
        width={40}
        height={40}
        format="png"
        class="size-5 rounded-md"
      />Kira Space</span
    >
    <span>MIT licence.</span>
    <a href={REPO_URL} rel="noopener" class="flex min-h-11 items-center hover:text-fg">GitHub</a>
    <a
      href={`${REPO_URL}/tree/main/site`}
      rel="noopener"
      class="flex min-h-11 items-center hover:text-fg"
    >
      Source of this page
    </a>
    <span class="flex flex-wrap items-center gap-x-1">
      Icons:
      <a
        href="https://github.com/microsoft/vscode-codicons"
        rel="noopener"
        class="flex min-h-11 items-center underline underline-offset-4 hover:text-fg"
        >Codicons</a
      >
      by Microsoft,
      <a
        href="https://creativecommons.org/licenses/by/4.0/"
        rel="noopener"
        class="flex min-h-11 items-center underline underline-offset-4 hover:text-fg"
        >CC BY 4.0</a
      >.
    </span>
  </div>
</footer>
