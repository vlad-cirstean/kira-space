---
import { ALSO, ENGINES } from '../data/content';
import Sparkle from './Sparkle.astro';

const palette = [
  'blue',
  'cyan',
  'orange',
  'teal',
  'amber',
  'green',
  'red',
  'violet',
  'magenta',
  'indigo',
];
const glyph = (name: string) => (name.length <= 3 ? name : name.slice(0, 2));
const rows = [
  {
    items: ENGINES.map((n, i) => ({ n, c: palette[i % palette.length] })),
    cls: 'motion-safe:animate-marquee',
  },
  {
    items: ALSO.map((n, i) => ({ n, c: palette[(i * 3 + 2) % palette.length] })),
    cls: 'motion-safe:animate-marquee-rev',
  },
];
const pill =
  'group/pill flex items-center gap-3 whitespace-nowrap rounded-full bg-white/[0.06] py-2 pl-2 pr-5 font-mono text-base font-semibold text-fg ring-1 ring-white/15 hover:bg-white/12 hover:shadow-[0_0_28px_-4px_var(--brand-glow)] sm:text-lg motion-safe:transition-[background-color,box-shadow]';
---

<section
  aria-labelledby="engines-title"
  class="relative isolate overflow-hidden bg-linear-to-b from-transparent via-brand-deep/30 to-transparent py-14 sm:py-20"
>
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_60%_50%_at_50%_50%,color-mix(in_srgb,var(--brand-sky)_26%,transparent),transparent)]"
  > </div>
  <div class="mx-auto max-w-6xl px-4 text-center">
    <span
      class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.14em] text-brand-glow"
    >
      <Sparkle class="size-3" />
      Ten engines. One grid. <Sparkle class="size-3" />
    </span>
    <h2 id="engines-title" class="sr-only">Supported engines and protocols</h2>
  </div>
  <div class="mt-7 flex flex-col gap-3 sm:gap-4">
    {rows.map((row) => (
      <div class="relative overflow-hidden">
        <span
          aria-hidden="true"
          class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-linear-to-r from-bg to-transparent motion-reduce:hidden sm:w-32"
        ></span>
        <span
          aria-hidden="true"
          class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-linear-to-l from-bg to-transparent motion-reduce:hidden sm:w-32"
        ></span>
        <div
          class={`flex w-max gap-3 hover:[animation-play-state:paused] focus-within:[animation-play-state:paused] ${row.cls} motion-reduce:w-auto motion-reduce:flex-wrap motion-reduce:justify-center motion-reduce:px-4 sm:gap-4`}
        >
          {[0, 1].map((copy) => (
            <ul
              aria-hidden={copy === 1 ? 'true' : undefined}
              class:list={[
                'flex shrink-0 gap-3 pr-3 sm:gap-4 sm:pr-4 motion-reduce:flex-wrap motion-reduce:justify-center motion-reduce:pr-0',
                copy === 1 && 'motion-reduce:hidden',
              ]}
            >
              {row.items.map((it) => (
                <li class={pill}>
                  <span
                    class="flex size-8 items-center justify-center rounded-full text-sm font-bold text-bg"
                    style={`background:var(--kira-conn-${it.c});box-shadow:0 0 14px var(--kira-conn-${it.c})`}
                  >
                    {glyph(it.n)}
                  </span>
                  {it.n}
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
