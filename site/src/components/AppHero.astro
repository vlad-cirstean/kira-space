---
import { type AppContent, SITE } from '../data/content';
import { href, REPO_URL } from '../data/nav';
import type { ResolvedWindowShot } from '../lib/shots';
import Icon from './Icon.astro';
import Shot from './Shot.astro';

interface Props {
  app: AppContent;
  shot: ResolvedWindowShot;
}

const { app, shot } = Astro.props;
const button =
  'group relative flex min-h-11 items-center gap-2 overflow-hidden rounded-lg px-5 font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-safe:transition-[transform,box-shadow,border-color] motion-safe:hover:-translate-y-0.5';
const primary = `${button} bg-accent text-accent-fg shadow-[0_8px_28px_-8px_color-mix(in_srgb,var(--kira-accent)_70%,transparent)] hover:shadow-[0_12px_34px_-8px_color-mix(in_srgb,var(--kira-accent)_90%,transparent)]`;
const secondary = `${button} border border-border-strong bg-elevated/60 text-fg hover:border-tint/60 hover:shadow-[0_0_0_3px_color-mix(in_srgb,var(--tint)_16%,transparent)]`;
---

<section class="mx-auto max-w-5xl px-4 pb-16 pt-10 sm:pt-16">
  <span
    class="hero-in flex items-center gap-2 text-sm font-medium uppercase tracking-wider text-tint"
  >
    <Icon name={app.icon} class="size-4" />
    {SITE.availability}
  </span>
  <h1
    style="--d:90ms"
    class="hero-in mt-4 bg-linear-to-b from-fg from-40% to-tint bg-clip-text pb-1 text-5xl font-semibold tracking-tight text-transparent sm:text-7xl"
  >
    {app.name}
  </h1>
  <p style="--d:180ms" class="hero-in mt-4 max-w-2xl text-base text-muted sm:text-lg">
    {app.summary}
  </p>
  <div style="--d:270ms" class="hero-in mt-8 flex flex-wrap gap-3">
    <a href="#install" class={primary}>
      <span
        aria-hidden="true"
        class="absolute inset-y-0 -left-full w-full skew-x-[-20deg] bg-linear-to-r from-transparent via-white/30 to-transparent motion-safe:group-hover:translate-x-[200%] motion-safe:transition-transform motion-safe:duration-700"
      ></span>
      <Icon name="cloud-download" class="size-4" />
      Install
    </a>
    <a href={href(app.docs)} class={secondary}>
      <Icon name="book" class="size-4" />
      Docs
    </a>
    <a href={REPO_URL} rel="noopener" class={secondary}>
      <Icon name="github" class="size-4" />
      GitHub
    </a>
  </div>
  <div class="relative mt-12">
    <div
      aria-hidden="true"
      class="absolute -inset-x-4 -inset-y-6 -z-10 rounded-[3rem] bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--tint)_22%,transparent),transparent)] motion-safe:animate-breathe"
    > </div>
    <div class="hero-tilt">
      <Shot shot={shot} eager />
    </div>
  </div>
</section>
