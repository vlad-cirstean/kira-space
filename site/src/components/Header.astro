---
import { Image } from 'astro:assets';
import appIcon from '../../../apps/kira-space/build/appicon.png';
import { href, NAV } from '../data/nav';

const home = href();
---

<header
  class="sticky top-0 z-10 bg-chrome/90 after:absolute after:inset-x-0 after:bottom-0 after:h-px after:bg-linear-to-r after:from-transparent after:via-brand-sky/60 after:to-transparent"
>
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between gap-2 px-4 py-2"
    aria-label="Main"
  >
    <a
      href={home}
      aria-label="Kira Space home"
      class="flex min-h-11 items-center gap-2 whitespace-nowrap font-semibold text-fg"
    >
      <Image
        src={appIcon}
        alt=""
        width={56}
        height={56}
        format="png"
        class="size-7 drop-shadow-[0_0_10px_var(--brand-sky)]"
      />
      <span class="hidden sm:inline">Kira Space</span>
    </a>
    <ul class="flex items-center gap-1">
      {NAV.map((link) => (
        <li>
          <a
            href={link.href}
            rel={link.external ? 'noopener' : undefined}
            class:list={[
              'relative flex min-h-11 items-center px-2 text-sm sm:px-3 sm:text-base',
              link.label === 'Install'
                ? 'rounded-full bg-linear-to-b from-brand-sky to-brand-deep font-semibold text-white shadow-[0_6px_20px_-6px_var(--brand-sky)] hover:brightness-110'
                : 'text-muted hover:text-fg after:absolute after:inset-x-2 after:bottom-2 after:h-px after:origin-center after:scale-x-0 after:bg-tint hover:after:scale-x-100 focus-visible:after:scale-x-100 sm:after:inset-x-3 motion-safe:after:transition-transform motion-safe:after:duration-300',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
