---
import { APP, INSTALL } from '../data/content';
import { REPO_URL } from '../data/nav';
import { installShot } from '../lib/installShots';
import Icon from './Icon.astro';

const { macos } = INSTALL;
const dialogs = macos.items.map((item) => ({
  title: item.title,
  body: item.body,
  image: 'image' in item ? { ...item.image, shot: installShot(item.image.file) } : undefined,
}));
---

<section id="install" class="mx-auto max-w-5xl px-4 pb-20">
  <div class="h-px bg-linear-to-r from-transparent via-tint/50 to-transparent"></div>
  <h2 class="reveal mt-16 text-2xl font-semibold tracking-tight sm:text-4xl">Install {APP.name}</h2>
  <ol class="mt-8 grid gap-4">
    <li class="reveal rounded-xl border border-border bg-elevated p-5 shadow-card">
      <span
        class="flex size-8 items-center justify-center rounded-full bg-tint/10 text-sm font-semibold text-tint ring-1 ring-tint/20"
        >1</span
      >
      <p class="mt-3 text-base text-fg">{INSTALL.steps[0]}</p>
      <div
        class="relative mt-4 overflow-hidden rounded-lg border border-border-strong bg-chrome shadow-[0_0_40px_-12px_color-mix(in_srgb,var(--tint)_45%,transparent)]"
      >
        <div
          aria-hidden="true"
          class="absolute inset-x-8 top-0 h-px bg-linear-to-r from-transparent via-tint to-transparent"
        ></div>
        <div
          class="flex items-center gap-2 border-b border-border-strong px-3 py-2 text-sm text-subtle"
        >
          <Icon name="terminal" class="size-4" />
          <span>{APP.name}</span>
        </div>
        <pre
          class="whitespace-pre-wrap break-all p-4 font-mono text-sm"
        ><code>{INSTALL.command}</code></pre>
      </div>
    </li>
  </ol>
  <div class="reveal mt-6 rounded-xl border border-border bg-elevated p-5 shadow-card">
    <h3 class="flex items-center gap-3 text-lg font-medium text-fg">
      <Icon name="lock" class="size-4 text-tint" />
      {macos.title}
    </h3>
    <p class="mt-2 text-base text-muted">{macos.intro}</p>
    <ul class="mt-4 grid gap-6 md:grid-cols-2">
      {dialogs.map((d) => (
        <li>
          <h4 class="font-medium text-fg">{d.title}</h4>
          <p class="mt-1 text-base text-muted">{d.body}</p>
          {d.image && (
            <figure class="m-0 mt-3">
              <img
                src={d.image.shot.src}
                width={d.image.shot.width / 2}
                height={d.image.shot.height / 2}
                alt={d.image.alt}
                loading="lazy"
                decoding="async"
                class="h-auto max-w-full drop-shadow-lg"
              >
              <figcaption class="mt-2 text-base text-muted">{d.image.caption}</figcaption>
            </figure>
          )}
        </li>
      ))}
    </ul>
  </div>
  <div class="mt-6 flex gap-3 rounded-xl border border-warn/40 bg-warn/10 p-4 text-base text-fg">
    <Icon name="warning" class="mt-1 size-4 text-warn" />
    <p>{INSTALL.note}</p>
  </div>
  <p class="mt-6 text-base">
    <a href={REPO_URL} rel="noopener" class="text-accent underline underline-offset-4">
      {INSTALL.source}
    </a>
  </p>
</section>
