---
import { getImage } from 'astro:assets';
import appIcon from '../../../apps/kira-space/build/appicon.png';
import { APP, INSTALL } from '../data/content';
import { REPO_URL } from '../data/nav';
import { installShot } from '../lib/installShots';
import Icon from './Icon.astro';
import Sparkle from './Sparkle.astro';

const { macos } = INSTALL;
const icon = await getImage({ src: appIcon, width: 192, height: 192, format: 'png' });
const dialogs = macos.items.map((item) => ({
  title: item.title,
  body: item.body,
  image: 'image' in item ? { ...item.image, shot: installShot(item.image.file) } : undefined,
}));
const card = 'glass relative flex flex-col overflow-hidden rounded-3xl p-6 [&>*]:relative';
---

<section id="install" class="relative isolate overflow-hidden px-4 pb-24 pt-24 lg:pt-32">
  <div
    aria-hidden="true"
    class="absolute left-1/2 top-0 -z-10 h-[40rem] w-[70rem] max-w-none -translate-x-1/2 bg-[radial-gradient(ellipse_50%_45%_at_50%_45%,color-mix(in_srgb,var(--brand-sky)_30%,transparent),transparent),radial-gradient(ellipse_30%_35%_at_70%_45%,color-mix(in_srgb,var(--kira-status-pink)_16%,transparent),transparent)]"
  ></div>
  <div class="mx-auto max-w-3xl text-center">
    <div class="relative mx-auto size-24">
      <span
        aria-hidden="true"
        class="absolute -inset-4 rounded-full bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--brand-sky)_55%,transparent),color-mix(in_srgb,var(--kira-status-pink)_30%,transparent)_60%,transparent)]"
      ></span>
      <div
        aria-hidden="true"
        class="relative size-full rounded-[1.4rem] bg-cover border border-white/30"
        style={`background-image:url(${icon.src})`}
      ></div>
      <Sparkle class="absolute -right-6 -top-2 size-5 text-brand-spark" />
      <Sparkle class="absolute -bottom-1 -left-7 size-3 text-pink" />
    </div>
    <h2 class="mt-8 text-4xl leading-[1.05] font-bold tracking-[-0.03em] sm:text-5xl lg:text-6xl">
      Install in <span class="gradient-text">one line.</span>
    </h2>
    <p class="mt-4 text-lg text-muted sm:text-xl">{INSTALL.steps[0]}</p>
  </div>
  <div class="gradient-border mx-auto mt-10 max-w-3xl rounded-2xl p-px">
    <div class="overflow-hidden rounded-[calc(1rem-1px)] bg-chrome">
      <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3 text-sm text-subtle">
        <span aria-hidden="true" class="size-3 rounded-full bg-red/80"></span>
        <span aria-hidden="true" class="size-3 rounded-full bg-amber/80"></span>
        <span aria-hidden="true" class="size-3 rounded-full bg-lime/80"></span>
        <Icon name="terminal" class="ml-2 size-4" />
        <span>{APP.name}</span>
      </div>
      <pre
        class="whitespace-pre-wrap break-all p-5 font-mono text-sm sm:text-base"
      ><span class="text-lime">$ </span><code>{INSTALL.command}</code></pre>
    </div>
  </div>
  <div class="mx-auto mt-20 max-w-5xl">
    <div class="text-center">
      <h3
        class="flex items-center justify-center gap-3 text-2xl font-semibold tracking-tight text-fg sm:text-3xl"
      >
        <Icon name="lock" class="size-6 text-pink" />
        {macos.title}
      </h3>
      <p class="mx-auto mt-3 max-w-2xl text-base text-muted sm:text-lg">{macos.intro}</p>
    </div>
    <ul class="mt-10 grid gap-5 md:grid-cols-2">
      {dialogs.map((d, i) => (
        <li
          class={`${card}`}
          style={`--glass:var(--kira-status-${i === 0 ? 'sky' : 'pink'});--i:${i}`}
        >
          <span
            aria-hidden="true"
            class="absolute inset-x-0 top-0 !absolute h-1 bg-linear-to-r from-transparent via-(--glass) to-transparent"
          ></span>
          <h4 class="text-lg font-semibold text-fg">{d.title}</h4>
          <p class="mt-2 text-base text-muted">{d.body}</p>
          {d.image ? (
            <figure class="m-0 mt-4">
              <img
                src={d.image.shot.src}
                width={d.image.shot.width / 2}
                height={d.image.shot.height / 2}
                alt={d.image.alt}
                loading="lazy"
                decoding="async"
                class="h-auto max-w-full"
              >
              <figcaption class="mt-2 text-base text-muted">{d.image.caption}</figcaption>
            </figure>
          ) : (
            <span
              aria-hidden="true"
              class="mt-auto flex size-16 items-center justify-center self-start rounded-full bg-pink/15 text-pink border border-pink/30"
            >
              <Icon name="files" class="size-8" />
            </span>
          )}
        </li>
      ))}
    </ul>
    <div
      class="mx-auto mt-8 flex max-w-3xl items-start gap-3 rounded-2xl bg-warn/10 p-4 text-base text-fg border border-warn/40"
    >
      <Icon name="warning" class="mt-1 size-4 text-warn" />
      <p>{INSTALL.note}</p>
    </div>
    <p class="mt-6 text-center text-base">
      <a
        href={REPO_URL}
        rel="noopener"
        class="inline-flex min-h-11 items-center text-accent underline underline-offset-4"
      >
        {INSTALL.source}
      </a>
    </p>
  </div>
</section>
