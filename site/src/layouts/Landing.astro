---
import Bento from '../components/Bento.astro';
import BuildBand from '../components/BuildBand.astro';
import EngineMarquee from '../components/EngineMarquee.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Install from '../components/Install.astro';
import Story from '../components/Story.astro';
import { APP as content, STORY } from '../data/content';
import { type ResolvedWindowShot, resolveAllShots } from '../lib/shots';
import Base from './Base.astro';

const shots = await resolveAllShots();
// Hero and story show a whole window, and og:image needs the window's social PNG.
function windowShot(id: string): ResolvedWindowShot {
  const shot = shots.find((s) => s.id === id);
  if (!shot) throw new Error(`Missing shot ${id}`);
  if (shot.kind !== 'window')
    throw new Error(`Shot ${id} is a ${shot.kind} crop, not a window shot`);
  return shot;
}
const hero = windowShot(content.hero);
---

<Base title={content.pageTitle} description={content.description} image={hero.social}>
  <Header />
  <main data-app="space" class="relative isolate overflow-hidden">
    <Hero front={hero} />
    <EngineMarquee />
    <Bento shots={content.features.flatMap((f) => (f.shot ? [windowShot(f.shot)] : []))} />
    <Story shots={STORY.map((c) => windowShot(c.shot))} />
    <BuildBand />
    <Install app={content} />
  </main>
  <Footer />
</Base>
